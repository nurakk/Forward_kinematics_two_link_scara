<?xml version="1.0"?>

<robot name="scara_robot">

  <!-- ================= BASE ================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!-- ================= LINK 1 ================= -->

  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 1 -->

  <joint name="joint1" type="revolute">
      <parent link="base_link"/>
      <child link="link1"/>

      <!-- Robot stands on Z-axis -->
      <origin xyz="0 0 0.10" rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
            lower="-3.14"
            upper="3.14"
            effort="100"
            velocity="1"/>
  </joint>

  <!-- ================= LINK 2 ================= -->

  <link name="link2">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.05 0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 2 -->

  <joint name="joint2" type="revolute">

      <parent link="link1"/>
      <child link="link2"/>

      <origin xyz="0.30 0 0" rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
            lower="-3.14"
            upper="3.14"
            effort="100"
            velocity="1"/>

  </joint>

  <!-- ================= PRISMATIC LINK ================= -->

  <link name="slider">

    <visual>

      <origin xyz="0 0 -0.10" rpy="0 0 0"/>

      <geometry>

        <cylinder radius="0.02" length="0.20"/>

      </geometry>

      <material name="yellow">

        <color rgba="1 1 0 1"/>

      </material>

    </visual>

  </link>

  <!-- Joint 3 -->

  <joint name="joint3" type="prismatic">

      <parent link="link2"/>

      <child link="slider"/>

      <origin xyz="0.30 0 0" rpy="0 0 0"/>

      <!-- Vertical Motion -->

      <axis xyz="0 0 -1"/>

      <limit
            lower="0"
            upper="0.20"
            effort="100"
            velocity="0.2"/>

  </joint>

  <!-- ================= END EFFECTOR ================= -->

  <link name="tool">

    <visual>

      <origin xyz="0 0 -0.02"/>

      <geometry>

        <sphere radius="0.03"/>

      </geometry>

      <material name="white">

        <color rgba="1 1 1 1"/>

      </material>

    </visual>

  </link>

  <joint name="tool_joint" type="fixed">

      <parent link="slider"/>

      <child link="tool"/>

      <origin xyz="0 0 -0.20"/>

  </joint>

</robot>
